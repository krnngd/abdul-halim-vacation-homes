---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Pic from '../components/Pic.astro';
import Rich from '../components/Rich.astro';
import ClosingBand from '../components/ClosingBand.astro';
import leadership from '../content/leadership.json';

const { meta, hero, groups, noPhotoLabel } = leadership;
const slug = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
---

<Base title={meta.title} description={meta.description}>
  <PageHeader eyebrow={hero.eyebrow} title={hero.title} intro={hero.intro} />

  {groups.map((group, groupIndex) => {
    const headingId = `group-${slug(group.title)}`;
    return (
      <section class:list={['section', 'people-section', { 'is-first': groupIndex === 0 }]} aria-labelledby={headingId}>
        <div class="container-x">
          <div class="people-head">
            <span class="people-count" aria-hidden="true">{String(groupIndex + 1).padStart(2, '0')}</span>
            <h2 id={headingId} class="display-2 people-title" data-split>{group.title}</h2>
          </div>
          <ul class="people-grid">
            {group.people.map((person) => (
              <li class="person hover-card" data-reveal>
                <div class="arch-wrap">
                  <div class:list={['arch', 'person-portrait', { 'is-initials': !person.photo }]}>
                    {person.photo ? (
                      <Pic
                        name={person.photo}
                        alt={`${person.name}, ${person.role}`}
                        sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 44vw, 90vw"
                        class="media-cover"
                        position="50% 18%"
                        maxWidth={800}
                      />
                    ) : (
                      <div class="initials" role="img" aria-label={`${person.name}: ${noPhotoLabel}`}>
                        <div class="pattern pattern-girih initials-pattern" aria-hidden="true" />
                        <span class="initials-text" aria-hidden="true">{person.initials}</span>
                        <span class="initials-note" aria-hidden="true">{noPhotoLabel}</span>
                      </div>
                    )}
                  </div>
                </div>
                <div class="person-body">
                  <h3 class="display-3 person-name">{person.name}</h3>
                  <p class="person-role">{person.role}</p>
                  <Rich as="p" class="person-resp" text={person.responsibility} />
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>
    );
  })}

  <ClosingBand />
</Base>

<style>
  .people-section.is-first {
    padding-top: clamp(4rem, 3rem + 3vw, 6rem);
  }

  .people-section + .people-section {
    padding-top: 0;
  }

  .people-head {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
    margin-bottom: clamp(2.5rem, 2rem + 2vw, 4rem);
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-line);
  }

  .people-count {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--color-saffron-deep);
  }

  .people-title {
    color: var(--color-gulf);
    font-size: clamp(1.875rem, 1.4rem + 1.8vw, 3rem);
  }

  .people-grid {
    display: grid;
    gap: 2rem 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16.5rem), 1fr));
  }

  @media (min-width: 64rem) {
    .people-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.5rem 2rem;
    }
  }

  @media (min-width: 100rem) {
    .people-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .person {
    display: grid;
    align-content: start;
    gap: 1.25rem;
    padding: 0.75rem 0.75rem 1.5rem;
    border-radius: calc(var(--radius-lg) + 0.75rem);
    background: var(--color-white);
    box-shadow: var(--shadow-md);
  }

  .person-portrait {
    aspect-ratio: 4 / 5;
    background: var(--color-mist);
  }

  .initials {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 0.75rem;
    background: linear-gradient(160deg, var(--color-gulf), var(--color-gulf-deep));
  }

  .initials-pattern {
    --pattern-opacity: 0.14;
    --pattern-size: 72px;
  }

  .initials-text {
    position: relative;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(3.5rem, 3rem + 2vw, 4.5rem);
    line-height: 1;
    letter-spacing: 0.04em;
    color: var(--color-saffron);
  }

  .initials-note {
    position: relative;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-on-dark-muted);
  }

  .person-body {
    display: grid;
    gap: 0.375rem;
    padding-inline: 0.75rem;
  }

  .person-name {
    color: var(--color-gulf);
    font-size: 1.5rem;
  }

  .person-role {
    font-weight: 650;
    font-size: 0.9375rem;
    color: var(--color-ink);
  }

  .person-resp {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    color: var(--color-ink-muted);
  }
</style>
