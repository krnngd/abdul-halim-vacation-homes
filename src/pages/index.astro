---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import Icon from '../components/Icon.astro';
import Rich from '../components/Rich.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ClosingBand from '../components/ClosingBand.astro';
import GroupStructure from '../components/GroupStructure.astro';
import home from '../content/home.json';

const { meta, hero, credentials, whatWeDo, statement, values, portfolio, group } = home;
---

<Base title={meta.title} description={meta.description}>
  <!-- Hero -->
  <section class="hero on-dark" data-hero aria-labelledby="hero-title">
    <div class="hero-bg" aria-hidden="true">
      <div class="hero-pattern" data-drift="90"><div class="pattern pattern-girih"></div></div>
      <div class="hero-glow"></div>
    </div>

    <div class="container-x hero-grid">
      <div class="hero-copy">
        <p class="eyebrow" data-reveal>{hero.eyebrow}</p>
        <h1 id="hero-title" class="display-hero hero-title" data-split>{hero.headline}</h1>
        <p class="lead hero-sub" data-reveal>{hero.sub}</p>
        <div class="hero-actions" data-reveal>
          <a class="btn btn-saffron" href={url(hero.primary.href)}>
            {hero.primary.label}
            <Icon name="arrow-right-linear" class="btn-icon" />
          </a>
          <a class="btn btn-ghost" href={url(hero.secondary.href)}>{hero.secondary.label}</a>
        </div>
      </div>

      <figure class="hero-figure">
        <div class="arch-wrap hero-arch-wrap">
          <span class="arch-frame" data-hero-frame aria-hidden="true"></span>
          <span class="hero-apex ornament-star" aria-hidden="true"></span>
          <div class="arch hero-arch" data-hero-image>
            <div class="parallax-inner" data-parallax="6">
              <Pic
                name={hero.image}
                alt={hero.imageAlt}
                sizes="(min-width: 64rem) 40rem, (min-width: 40rem) 26rem, 88vw"
                class="media-cover"
                position="50% 40%"
                priority
              />
            </div>
          </div>
        </div>
        <figcaption class="hero-caption">
          <span class="hero-caption-line" aria-hidden="true"></span>
          {hero.caption}
        </figcaption>
      </figure>
    </div>

    <div class="hero-scroll" aria-hidden="true">
      <span>{hero.scrollHint}</span>
      <span class="hero-scroll-line"></span>
    </div>
  </section>

  <!-- Credentials -->
  <section class="credentials" aria-labelledby="credentials-title">
    <div class="container-x">
      <div class="credentials-panel" data-reveal>
        <h2 id="credentials-title" class="sr-only">{credentials.title}</h2>
        <ul class="credentials-list">
          {credentials.items.map((item) => (
            <li class="credential">
              <Icon name={item.icon} class="credential-icon" />
              <Rich as="p" class="credential-text" text={item.text} />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- What we do -->
  <section class="section what" aria-labelledby="what-title">
    <div class="container-x">
      <div class="what-head">
        <SectionHeading eyebrow={whatWeDo.eyebrow} title={whatWeDo.title} id="what-title" />
        <a class="arrow-link" href={url(whatWeDo.link.href)} data-reveal>
          {whatWeDo.link.label}
          <span class="arrow-dot" aria-hidden="true"><Icon name="arrow-right-linear" /></span>
        </a>
      </div>

      <ol class="what-grid">
        {whatWeDo.items.map((item, index) => (
          <li class="what-card surface hover-card group" data-reveal>
            <div class="what-card-top">
              <span class="icon-tile"><Icon name={item.icon} /></span>
              <span class="what-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            </div>
            <h3 class="display-3 what-card-title">{item.title}</h3>
            <p class="what-card-body">{item.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Statement -->
  <section class="statement" aria-labelledby="statement-title">
    <div class="container-x statement-inner">
      <span class="statement-star ornament-star" aria-hidden="true"></span>
      <h2 id="statement-title" class="eyebrow statement-label">{statement.label}</h2>
      <p class="statement-text" data-scrub-words>{statement.text}</p>
    </div>
  </section>

  <!-- Values -->
  <section class="values on-dark" aria-labelledby="values-title">
    <div class="values-pattern" aria-hidden="true"><div class="pattern pattern-girih"></div></div>
    <div class="container-x section values-inner">
      <div class="values-head">
        <SectionHeading eyebrow={values.eyebrow} title={values.title} id="values-title" />
        <a class="arrow-link" href={url(values.link.href)} data-reveal>
          {values.link.label}
          <span class="arrow-dot" aria-hidden="true"><Icon name="arrow-right-linear" /></span>
        </a>
      </div>
      <ol class="values-list">
        {values.items.map((item, index) => (
          <li class="value" data-reveal>
            <span class="value-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="display-3 value-title">{item.title}</h3>
            <p class="value-body">{item.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Portfolio preview -->
  <section class="section preview" aria-labelledby="preview-title">
    <div class="container-x">
      <div class="what-head">
        <SectionHeading eyebrow={portfolio.eyebrow} title={portfolio.title} id="preview-title" />
        <a class="arrow-link" href={url(portfolio.link.href)} data-reveal>
          {portfolio.link.label}
          <span class="arrow-dot" aria-hidden="true"><Icon name="arrow-right-linear" /></span>
        </a>
      </div>
    </div>

    <div class="preview-scroller" role="region" aria-label={portfolio.scrollerLabel} tabindex="0">
      <ul class="preview-grid">
        {portfolio.items.map((item) => (
          <li class="preview-item" data-reveal>
            <a class="preview-card" href={url(`/portfolio/?area=${item.areaId}`)}>
              <div class="arch-wrap">
                <div class="arch preview-arch">
                  <Pic name={item.image} alt={item.alt} sizes="(min-width: 64rem) 18vw, (min-width: 40rem) 34vw, 70vw" class="media-cover preview-img" />
                </div>
              </div>
              <span class="preview-area">{item.area}</span>
              <span class="preview-type">{item.type}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Group of companies -->
  <section class="section group-section bg-mist" aria-labelledby="group-title">
    <div class="container-x">
      <div class="what-head">
        <SectionHeading eyebrow={group.eyebrow} title={group.title} id="group-title" />
        <a class="arrow-link" href={url(group.link.href)} data-reveal>
          {group.link.label}
          <span class="arrow-dot" aria-hidden="true"><Icon name="arrow-right-linear" /></span>
        </a>
      </div>
      <GroupStructure variant="summary" />
    </div>
  </section>

  <ClosingBand spaced />
</Base>

<style>
  /* Hero ------------------------------------------------------------- */
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: linear-gradient(162deg, var(--color-gulf) 0%, var(--color-gulf-deep) 58%, var(--color-gulf-ink) 100%);
    padding-block: clamp(8rem, 6rem + 6vw, 12rem) clamp(7rem, 5rem + 6vw, 11rem);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero-pattern {
    position: absolute;
    inset: -10% 0 0 0;
    mask-image: radial-gradient(80% 70% at 78% 35%, #000 0%, transparent 70%);
  }

  .hero-pattern .pattern {
    --pattern-opacity: 0.14;
    --pattern-size: 112px;
  }

  .hero-glow {
    display: none;
    position: absolute;
    inset-block-start: 10%;
    inset-inline-end: 8%;
    inline-size: 40rem;
    block-size: 40rem;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--color-gulf-soft) 85%, transparent), transparent);
    opacity: 0.8;
  }

  .hero-grid {
    position: relative;
    display: grid;
    gap: 4rem;
    align-items: center;
  }

  .hero-copy {
    display: grid;
    gap: clamp(1.75rem, 1.25rem + 0.8vw, 2.5rem);
    justify-items: start;
  }

  .hero-title {
    max-inline-size: 15ch;
  }

  .hero-sub {
    max-inline-size: 40rem;
    color: var(--color-on-dark-muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .hero-figure {
    position: relative;
    justify-self: center;
    inline-size: min(100%, 26rem);
  }

  .hero-arch-wrap {
    position: relative;
  }

  .hero-arch {
    aspect-ratio: 4 / 5;
    background: var(--color-gulf-deep);
    box-shadow: var(--shadow-lg);
  }

  .parallax-inner {
    position: absolute;
    inset: -8% 0;
  }

  .hero-apex {
    position: absolute;
    z-index: 2;
    inset-block-start: -1.75rem;
    left: 50%; /* physical: centred in both directions */
    inline-size: 1.75rem;
    block-size: 1.75rem;
    translate: -50% 0;
  }

  .hero-caption {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-on-dark-muted);
  }

  .hero-caption-line {
    inline-size: 2.5rem;
    block-size: 1px;
    background: var(--color-saffron);
  }

  .hero-scroll {
    position: absolute;
    inset-block-end: calc(clamp(3.5rem, 2.5rem + 4vw, 5.5rem) + 1.25rem);
    left: 50%; /* physical: centred in both directions */
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    translate: -50% 0;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-on-dark-muted);
  }

  .hero-scroll-line {
    inline-size: 1px;
    block-size: 3rem;
    background: linear-gradient(var(--color-saffron), transparent);
  }

  @media (min-width: 64rem) {
    .hero {
      min-block-size: 100svh;
      display: flex;
      align-items: center;
    }

    .hero-grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.9fr);
      gap: clamp(3rem, 7vw, 9rem);
    }

    .hero-figure {
      justify-self: end;
      inline-size: 100%;
      max-inline-size: 40rem;
    }

    .hero-scroll {
      display: flex;
    }

    .hero-glow {
      display: block;
    }
  }

  /* Credentials -------------------------------------------------------- */
  .credentials {
    position: relative;
    z-index: 2;
    margin-top: calc(clamp(3.5rem, 2.5rem + 4vw, 5.5rem) * -1);
  }

  .credentials-panel {
    border-radius: var(--radius-lg);
    background: var(--color-white);
    box-shadow: var(--shadow-lg);
    padding: clamp(0.5rem, 0.25rem + 1vw, 1rem);
  }

  .credentials-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }

  .credential {
    position: relative;
    display: grid;
    gap: 1rem;
    align-content: start;
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
  }

  .credential + .credential::before {
    content: "";
    position: absolute;
    inset-block: 1.5rem;
    inset-inline-start: 0;
    inline-size: 1px;
    background: linear-gradient(180deg, transparent, var(--color-saffron), transparent);
  }

  .credential-icon {
    inline-size: 2rem;
    block-size: 2rem;
    color: var(--color-saffron);
  }

  .credential-text {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.375rem;
    line-height: 1.25;
    color: var(--color-gulf);
  }

  @media (max-width: 63.999rem) {
    .credentials-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .credential:nth-child(3)::before {
      display: none;
    }

    .credential:nth-child(n + 3)::after {
      content: "";
      position: absolute;
      inset-inline: 1.5rem;
      inset-block-start: 0;
      block-size: 1px;
      background: linear-gradient(90deg, transparent, var(--color-saffron), transparent);
    }
  }

  @media (max-width: 30rem) {
    .credentials-list {
      grid-template-columns: 1fr;
    }

    .credential + .credential::before {
      display: none;
    }

    .credential + .credential::after {
      content: "";
      position: absolute;
      inset-inline: 1.5rem;
      inset-block-start: 0;
      block-size: 1px;
      background: linear-gradient(90deg, transparent, var(--color-saffron), transparent);
    }
  }

  /* What we do ----------------------------------------------------------- */
  .what-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem 3rem;
    margin-bottom: clamp(3rem, 2rem + 3vw, 5rem);
  }

  .what-grid {
    display: grid;
    align-items: start;
    gap: 1.5rem;
  }

  @media (min-width: 48rem) {
    .what-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .what-grid > :nth-child(2) {
      margin-top: 3rem;
    }

    .what-grid > :nth-child(3) {
      margin-top: 6rem;
    }
  }

  .what-card {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: clamp(1.75rem, 1.5rem + 1vw, 2.5rem);
    border-radius: var(--radius-md);
  }

  .what-card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 2.5rem;
  }

  .what-index {
    font-family: var(--font-display);
    font-size: 2.75rem;
    line-height: 1;
    color: var(--color-line);
  }

  .what-card-title {
    color: var(--color-gulf);
  }

  .what-card-body {
    color: var(--color-ink-muted);
  }

  /* Statement -------------------------------------------------------- */
  .statement {
    padding-block: 0 var(--section-y);
  }

  .statement-inner {
    display: grid;
    justify-items: center;
    gap: 1.75rem;
    text-align: center;
  }

  .statement-star {
    inline-size: 2.5rem;
    block-size: 2.5rem;
  }

  .statement-text {
    max-inline-size: 26ch;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.125rem, 1.4rem + 3vw, 4.5rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--color-gulf);
    text-wrap: balance;
  }

  /* Values --------------------------------------------------------------- */
  .values {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: var(--color-gulf-deep);
  }

  .values-pattern {
    position: absolute;
    inset: 0;
    z-index: -1;
    mask-image: radial-gradient(60% 80% at 0% 100%, #000 0%, transparent 70%);
  }

  .values-pattern .pattern {
    --pattern-opacity: 0.12;
    --pattern-size: 96px;
  }

  .values-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem 3rem;
    margin-bottom: clamp(3rem, 2rem + 3vw, 5rem);
  }

  .values-list {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 48rem) {
    .values-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.5rem;
    }
  }

  .value {
    display: grid;
    gap: 1rem;
    align-content: start;
    padding-top: 2rem;
    border-top: 1px solid color-mix(in srgb, var(--color-saffron) 60%, transparent);
  }

  .value-index {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: var(--color-saffron);
  }

  .value-title {
    font-size: clamp(1.875rem, 1.5rem + 1.2vw, 2.5rem);
  }

  .value-body {
    color: var(--color-on-dark-muted);
    max-inline-size: 30ch;
  }

  /* Portfolio preview --------------------------------------------------- */
  .preview-scroller {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-inline: var(--gutter);
    scroll-padding-inline: var(--gutter);
    border-radius: var(--radius-xs);
  }

  .preview-scroller::-webkit-scrollbar {
    display: none;
  }

  .preview-grid {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(15rem, 72vw);
    gap: 1.25rem;
    padding-block: 1rem 2rem;
  }

  .preview-item {
    scroll-snap-align: start;
  }

  @media (min-width: 40rem) {
    .preview-grid {
      grid-auto-columns: minmax(15rem, 40vw);
    }
  }

  @media (min-width: 64rem) {
    .preview-scroller {
      overflow: visible;
      max-inline-size: calc(var(--container) + var(--gutter) * 2);
      margin-inline: auto;
    }

    .preview-grid {
      grid-auto-flow: row;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1.5rem;
    }

    .preview-item:nth-child(even) {
      margin-top: 4rem;
    }
  }

  .preview-card {
    display: grid;
    gap: 0.5rem;
    border-radius: var(--radius-md);
  }

  .preview-arch {
    aspect-ratio: 3 / 4.2;
    margin-bottom: 1rem;
    background: var(--color-mist);
    box-shadow: var(--shadow-md);
  }

  .preview-img {
    transition: transform 1200ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .preview-card:hover .preview-img {
      transform: scale(1.06);
    }
  }

  .preview-area {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-saffron-deep);
  }

  .preview-type {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.375rem;
    line-height: 1.2;
    color: var(--color-gulf);
  }
</style>
